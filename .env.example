# Drizzle
DATABASE_URL=file:local.db
ASSET_DIR=./data/assets
BODY_SIZE_LIMIT=32M

# Server-only post-game import (HenrikDev requires an authorized API key).
HENRIKDEV_API_KEY=
HENRIKDEV_BASE_URL=https://api.henrikdev.xyz
HENRIKDEV_AFFINITY=ap
HENRIKDEV_PLATFORM=pc
HENRIKDEV_CANDIDATE_LIMIT=5
POST_GAME_REQUEST_TIMEOUT_MS=15000
# Hosted statistics service, separate from Spectra live socket/extras hosts.
SPECTRA_POST_GAME_BASE_URL=https://stats.valospectra.com
# Blank reuses saved live-provider group code; operators can enter one per fetch.
SPECTRA_POST_GAME_GROUP_CODE=
SPECTRA_POST_GAME_POLL_INTERVAL_MS=15000
SPECTRA_POST_GAME_MAX_ATTEMPTS=3
