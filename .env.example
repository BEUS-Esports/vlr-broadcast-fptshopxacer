# Drizzle
DATABASE_URL=file:local.db
ASSET_DIR=./data/assets
BODY_SIZE_LIMIT=32M

# TSLog terminal output. debug includes successful reads and polling requests.
LOG_LEVEL=info
# Optional JSONL files: 10 MB per file, seven archives. One directory per server process.
# LOG_DIR=./data/logs

# Provider settings are saved in the database. Secrets are encrypted with this server key.
# Recommended for production: 32 random bytes encoded as base64 or 64 hex characters.
SETTINGS_ENCRYPTION_KEY=
# If SETTINGS_ENCRYPTION_KEY is blank, a local 32-byte key is generated here on first use.
SETTINGS_ENCRYPTION_KEY_FILE=./data/settings.key

# Legacy bootstrap only.
# These values are imported only when provider_settings is first created, then the Settings page/DB wins.
HENRIKDEV_API_KEY=
HENRIKDEV_BASE_URL=https://api.henrikdev.xyz
HENRIKDEV_AFFINITY=ap
HENRIKDEV_PLATFORM=pc
HENRIKDEV_CANDIDATE_LIMIT=5
POST_GAME_REQUEST_TIMEOUT_MS=15000
SPECTRA_POST_GAME_BASE_URL=https://stats.valospectra.com
SPECTRA_POST_GAME_GROUP_CODE=
SPECTRA_POST_GAME_POLL_INTERVAL_MS=15000
SPECTRA_POST_GAME_MAX_ATTEMPTS=3
